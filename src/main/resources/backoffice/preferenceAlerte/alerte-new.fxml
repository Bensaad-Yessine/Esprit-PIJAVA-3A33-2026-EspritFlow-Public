<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="piJava.Controllers.backoffice.preferenceAlerte.AlerteNewController"
      styleClass="dashboard-root"
      stylesheets="@alerte-new.css">

    <VBox styleClass="main-content" spacing="20" HBox.hgrow="ALWAYS" fillWidth="true">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Nouvelle Préférence d'Alerte" styleClass="page-title"/>
                <Label text="Créer une configuration utilisateur personnalisée" styleClass="page-subtitle"/>
            </VBox>
        </HBox>

        <!-- SCROLLABLE AREA -->
        <ScrollPane fitToWidth="true" pannable="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <content>

                <VBox styleClass="form-card" spacing="8">

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: INFORMATIONS GÉNÉRALES -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Label text="📋 INFORMATIONS GÉNÉRALES" styleClass="section-header"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Utilisateur" styleClass="form-label-highlight"/>
                        <Label text="*" styleClass="required-star"/>
                    </HBox>
                    <ComboBox fx:id="cbUser" promptText="Sélectionner un utilisateur..." styleClass="input"/>
                    <Label fx:id="userError" styleClass="error-label"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Nom de la préférence" styleClass="form-label-highlight"/>
                        <Label text="*" styleClass="required-star"/>
                    </HBox>
                    <TextField fx:id="nomField" promptText="Ex: Alerte Email Matin" styleClass="input"/>
                    <Label fx:id="nomError" styleClass="error-label"/>

                    <Label text="Description détaillée" styleClass="form-label"/>
                    <TextArea fx:id="descriptionField" promptText="Décrivez le but de cette préférence d'alerte..." styleClass="input" wrapText="true"/>
                    <Label fx:id="descriptionError" styleClass="error-label"/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: CONFIGURATION -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Label text="⚙️ CONFIGURATION" styleClass="section-header"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Délai de rappel" styleClass="form-label-highlight"/>
                        <Label text="(minutes)" styleClass="info-badge"/>
                    </HBox>
                    <TextField fx:id="delaiField" promptText="Ex: 30" styleClass="input"/>
                    <Label fx:id="delaiError" styleClass="error-label"/>

                    <Label text="Plage de silence" styleClass="form-label"/>
                    <HBox spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Début" styleClass="form-label" style="-fx-font-size: 11px;"/>
                            <TextField fx:id="debutField" promptText="HH:mm" styleClass="input"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Fin" styleClass="form-label" style="-fx-font-size: 11px;"/>
                            <TextField fx:id="finField" promptText="HH:mm" styleClass="input"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="timeError" styleClass="error-label"/>

                    <Separator/>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- SECTION: OPTIONS -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Label text="🔘 OPTIONS" styleClass="section-header"/>

                    <HBox spacing="20">
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <CheckBox fx:id="activeCheck" text="Activer cette alerte">
                                <tooltip>
                                    <Tooltip text="Activer ou désactiver cette préférence"/>
                                </tooltip>
                            </CheckBox>
                            <CheckBox fx:id="defaultCheck" text="Définir par défaut">
                                <tooltip>
                                    <Tooltip text="Utiliser comme configuration par défaut"/>
                                </tooltip>
                            </CheckBox>
                        </VBox>
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <CheckBox fx:id="emailCheck" text="📧 Notification Email">
                                <tooltip>
                                    <Tooltip text="Envoyer les alertes par email"/>
                                </tooltip>
                            </CheckBox>
                            <CheckBox fx:id="pushCheck" text="📱 Notification Push">
                                <tooltip>
                                    <Tooltip text="Envoyer les alertes push"/>
                                </tooltip>
                            </CheckBox>
                            <CheckBox fx:id="siteCheck" text="🌐 Notification Site">
                                <tooltip>
                                    <Tooltip text="Afficher les alertes sur le site"/>
                                </tooltip>
                            </CheckBox>
                        </VBox>
                    </HBox>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!-- ACTIONS -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <Region minHeight="20"/>
                    <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="form-section">
                        <Button text="❌ Annuler" onAction="#handleCancel" styleClass="btn-secondary"/>
                        <Button text="✓ Créer la préférence" onAction="#handleAdd" styleClass="btn-primary"/>
                    </HBox>

                </VBox>

            </content>
        </ScrollPane>
    </VBox>
</HBox>